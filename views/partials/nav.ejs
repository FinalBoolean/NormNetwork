<%
  const links = [
    { href: '/finder', label: 'Finder', match: '/finder' },
    { href: '/threads', label: 'Threads', match: '/threads' },
    { href: '/friends', label: 'Friends', match: '/friends' },
    { href: '/profile', label: 'Profile', match: '/profile' },
  ];
  const path = typeof currentPath !== 'undefined' ? currentPath : '';
  const user = typeof currentUser !== 'undefined' ? currentUser : null;
%>
<header class="site-header">
  <nav class="container nav">
    <a class="brand" href="/"><span class="brand-mark">NN</span> Norm's Network</a>
    <ul class="nav-links">
      <% links.forEach(link => { %>
        <li><a href="<%= link.href %>" class="<%= path.startsWith(link.match) ? 'active' : '' %>"><%= link.label %></a></li>
      <% }) %>
      <% if (user) { %>
        <li class="nav-user">@<%= user.username %></li>
        <li>
          <form method="post" action="/logout" class="nav-logout">
            <button class="btn btn-small" type="submit">Log out</button>
          </form>
        </li>
      <% } else { %>
        <li><a href="/signup" class="<%= path === '/signup' ? 'active' : '' %>">Sign up</a></li>
        <li><a class="btn btn-small" href="/login">Log in</a></li>
      <% } %>
    </ul>
  </nav>
</header>
