<%- include('../partials/head') %>

<section class="panel auth-panel">
  <h1>Create your account</h1>
  <p class="lede">Sign up with your UNC Charlotte email.</p>

  <% if (Object.keys(errors).length) { %>
    <div class="alert alert-error" role="alert">
      <% if (errors.form) { %><%= errors.form %><% } else { %>Please fix the highlighted fields.<% } %>
    </div>
  <% } %>

  <form class="form" method="post" action="/signup" novalidate>
    <% if (next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>

    <div class="field<%= errors.username ? ' has-error' : '' %>">
      <label for="username">Username</label>
      <input id="username" name="username" type="text" autocomplete="username" required
             minlength="3" maxlength="30" value="<%= values.username || '' %>"
             <% if (errors.username) { %>aria-invalid="true" aria-describedby="username-error"<% } %>>
      <% if (errors.username) { %><p class="field-error" id="username-error"><%= errors.username %></p><% } %>
    </div>

    <div class="field<%= errors.email ? ' has-error' : '' %>">
      <label for="email">UNC Charlotte email</label>
      <input id="email" name="email" type="email" autocomplete="email" required
             maxlength="255" placeholder="you@charlotte.edu" value="<%= values.email || '' %>"
             <% if (errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>>
      <% if (errors.email) { %><p class="field-error" id="email-error"><%= errors.email %></p><% } %>
    </div>

    <div class="field<%= errors.password ? ' has-error' : '' %>">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" required
             minlength="8" maxlength="128"
             aria-describedby="<%= errors.password ? 'password-error' : 'password-hint' %>"
             <% if (errors.password) { %>aria-invalid="true"<% } %>>
      <% if (errors.password) { %><p class="field-error" id="password-error"><%= errors.password %></p>
      <% } else { %><p class="field-hint" id="password-hint">At least 8 characters.</p><% } %>
    </div>

    <div class="field<%= errors.confirmPassword ? ' has-error' : '' %>">
      <label for="confirmPassword">Confirm password</label>
      <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required
             <% if (errors.confirmPassword) { %>aria-invalid="true" aria-describedby="confirm-error"<% } %>>
      <% if (errors.confirmPassword) { %><p class="field-error" id="confirm-error"><%= errors.confirmPassword %></p><% } %>
    </div>

    <button class="btn" type="submit">Create account</button>
  </form>

  <p class="form-footer">Already have an account? <a href="/login<%= next ? '?next=' + encodeURIComponent(next) : '' %>">Log in</a></p>
</section>

<%- include('../partials/footer') %>
