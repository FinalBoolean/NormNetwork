<%- include('../partials/head') %>

<section class="panel auth-panel">
  <h1>Log in</h1>
  <p class="lede">Welcome back to Norm's Network.</p>

  <% if (notice) { %><div class="alert alert-info" role="status"><%= notice %></div><% } %>
  <% if (errors.form) { %><div class="alert alert-error" role="alert"><%= errors.form %></div><% } %>

  <form class="form" method="post" action="/login" novalidate>
    <% if (next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>

    <div class="field<%= errors.login ? ' has-error' : '' %>">
      <label for="login">Email or username</label>
      <input id="login" name="login" type="text" autocomplete="username" required
             value="<%= values.login || '' %>"
             <% if (errors.login) { %>aria-invalid="true" aria-describedby="login-error"<% } %>>
      <% if (errors.login) { %><p class="field-error" id="login-error"><%= errors.login %></p><% } %>
    </div>

    <div class="field<%= errors.password ? ' has-error' : '' %>">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required
             <% if (errors.password) { %>aria-invalid="true" aria-describedby="password-error"<% } %>>
      <% if (errors.password) { %><p class="field-error" id="password-error"><%= errors.password %></p><% } %>
    </div>

    <button class="btn" type="submit">Log in</button>
  </form>

  <p class="form-footer">New here? <a href="/signup<%= next ? '?next=' + encodeURIComponent(next) : '' %>">Create an account</a></p>
</section>

<%- include('../partials/footer') %>
