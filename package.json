{
  "name": "normnetwork",
  "version": "1.0.0",
  "description": "Norm's Network: find friends, study partners, and gaming groups.",
  "main": "server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js latest",
    "db:rollback": "node --env-file-if-exists=.env scripts/migrate.js down",
    "db:status": "node --env-file-if-exists=.env scripts/migrate.js status"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FinalBoolean/NormNetwork.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/FinalBoolean/NormNetwork/issues"
  },
  "homepage": "https://github.com/FinalBoolean/NormNetwork#readme",
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "kysely": "^0.29.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  },
  "engines": {
    "node": ">=22.9"
  }
}
